#==================================================#
#                  LOCAL DEV SECRETS                #
#==================================================#
# This file contains ALL secrets for local development
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git!

#--------------------------------------------------#
# Runtime Secrets (used by running containers)
#--------------------------------------------------#
JWT_SECRET=your-jwt-secret-here-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=your-refresh-secret-here-use-openssl-rand-hex-32
API_KEY_ENCRYPTION_KEY=your-encryption-key-here-use-openssl-rand-hex-32

# Keycloak Admin
KEYCLOAK_ADMIN_PASSWORD=admin123

#--------------------------------------------------#
# Build-time Secrets (used by Docker build / realm generation)
#--------------------------------------------------#
# App FQDN (used in realm template)
APP_FQDN=https://airwall.local

# Azure/Microsoft Identity Provider
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_ID_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Google Identity Provider (optional - uncomment if needed)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

#--------------------------------------------------#
# DEPRECATED FILES (DO NOT USE)
#--------------------------------------------------#
# .env.secrets - merged into .env.local
# .env.keycloak - merged into .env.local
