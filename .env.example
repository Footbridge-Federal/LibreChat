#==================================================#
#         REQUIRED: Must be set in .env             #
#==================================================#

# Application Domain (REQUIRED)
# All Keycloak URLs are automatically derived from this
APP_FQDN=https://airwall.local

# MongoDB Connection (REQUIRED)
MONGO_URI=mongodb://mongodb:27017/Airwall

# RAG API URL (REQUIRED if using RAG)
RAG_OPENAI_BASEURL=http://rag_api:8000/v1

# Application Title
APP_TITLE=Airwall.Chat

# Help URL
HELP_AND_FAQ_URL=https://airwall.ai

#==================================================#
# The following are automatically derived from APP_FQDN:
# DOMAIN_CLIENT=${APP_FQDN}
# DOMAIN_SERVER=${APP_FQDN}
# KEYCLOAK_SERVER_URL=${APP_FQDN}/keycloak
# REACT_APP_KEYCLOAK_URL=${APP_FQDN}/keycloak
# KEYCLOAK_ADMIN_URL=${APP_FQDN}/keycloak
# OPENID_ISSUER=${APP_FQDN}/keycloak/realms/AirwallChat
#
# Only override these if you need custom URLs
#==================================================#

#===================================================#
#         REQUIRED SECRETS (.env.secrets)           #
#===================================================#
# These should be in .env.secrets, not here
# JWT_SECRET=<generate-secure-random-string>
# JWT_REFRESH_SECRET=<generate-secure-random-string>
# API_KEY_ENCRYPTION_KEY=<generate-secure-random-string>

#=================#
#    Keycloak     #
#=================#

# NOTE: Most Keycloak URLs are automatically derived from APP_FQDN
# (see above - KEYCLOAK_SERVER_URL, OPENID_ISSUER, etc.)

# Keycloak Client Credentials (REQUIRED if using Keycloak)
OPENID_CLIENT_ID=librechat-client
OPENID_CLIENT_SECRET=librechat-secret-123
OPENID_SESSION_SECRET=your-session-secret-change-in-production

# Keycloak Admin Credentials (REQUIRED if using Keycloak)
KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=<.env.secrets>

# Keycloak Realm Configuration (REQUIRED if using Keycloak)
KEYCLOAK_TARGET_REALM=AirwallChat
REACT_APP_KEYCLOAK_REALM=AirwallChat

#==================================================#
#     OPTIONAL: Has Defaults in code              #
#==================================================#

# Server Configuration (defaults in api/server/config/defaults.js)
# PORT=3080
# HOST=localhost
# NODE_ENV=production
# HTTPS=false
# NODE_TLS_REJECT_UNAUTHORIZED=1

# User System (defaults in api/server/config/defaults.js)
# BAN_VIOLATIONS=false
# LIMIT_CONCURRENT_MESSAGES=false
# ALLOW_SOCIAL_LOGIN=true
# ALLOW_EMAIL_LOGIN=true
# ALLOW_REGISTRATION=false

# Search (defaults in api/server/config/defaults.js)
# SEARCH=false

# Keycloak Settings (defaults in api/server/config/defaults.js)
# REFRESH_TOKEN_EXPIRY=8000
# OPENID_SCOPE=openid
# OPENID_CALLBACK_URL=/oauth/openid/callback
# OPENID_BUTTON_LABEL="Continue with Keycloak"
# OPENID_AUTO_REDIRECT=true
# OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles
# OPENID_REQUIRED_ROLE_TOKEN_KIND=access
# KEYCLOAK_ROLE_SYNC_ENABLED=true
# KEYCLOAK_ROLE_SYNC_INTERVAL_MINUTES=60
# KEYCLOAK_ROLE_MAPPING_PREFIX=airwall-
# KEYCLOAK_REQUIRE_EMAIL_VERIFIED=false
# KEYCLOAK_AUTO_CREATE_USERS=true
# KEYCLOAK_AUTO_SYNC_ROLES=true
# OPENID_MAX_RETRIES=300
# OPENID_RETRY_INTERVAL=3000
# OPENID_USE_END_SESSION_ENDPOINT=true
# OPENID_REUSE_TOKENS=true
# KEYCLOAK_ENABLED=true
# KEYCLOAK_ADMIN_REALM=master
# KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# Model Access Control (defaults in api/server/config/defaults.js)
# MODEL_ACCESS_ENABLED=true
