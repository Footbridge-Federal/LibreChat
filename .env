#==================================================#
#               Server Configuration               #
#==================================================#
MONGO_URI=mongodb://mongodb:27017/Airwall
RAG_OPENAI_BASEURL=http://rag_api:8000/v1
DOMAIN_CLIENT=https://airwall.local
DOMAIN_SERVER=https://airwall.local
APP_TITLE=Airwall.Chat
HELP_AND_FAQ_URL=https://airwall.ai
# JWT_SECRET=<.env.secrets>
# JWT_REFRESH_SECRET=<.env.secrets>

#===================================================#
#                    User System                    #
#===================================================#
BAN_VIOLATIONS=false
LIMIT_CONCURRENT_MESSAGES=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_ENV=development
HTTPS=false


#=================#
#       AWS       #
#=================#
BEDROCK_AWS_MODELS=us.anthropic.claude-opus-4-1-20250805-v1:0
AWS_DEFAULT_REGION=us-east-1
BEDROCK_AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID= <.env.secrets>
# AWS_SECRET_ACCESS_KEY= <.env.secrets>

#=================#
#     OpenAI      #
#=================#
OPENAI_MODELS=gpt-5,gpt-5-mini,gpt-5-nano,gpt-5-chat-latest


#===================================================#
#                        RAG                        #
#===================================================#
EMBEDDINGS_PROVIDER=bedrock
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0

#==================================================#
#                      Search                      #
#==================================================#
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://0.0.0.0:7700
MEILI_MASTER_KEY=DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt


#=================#
#    Keycloak     #
#=================#
# Basic OpenID Connect Configuration
OPENID_ISSUER=https://airwall.local/keycloak/realms/AirwallChat
OPENID_CLIENT_ID=librechat-client
OPENID_CLIENT_SECRET=librechat-secret-123
OPENID_SCOPE=openid
OPENID_SESSION_SECRET=your-session-secret-change-in-production
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Continue with Keycloak
OPENID_AUTO_REDIRECT=false

# Role Integration Configuration
OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles
OPENID_REQUIRED_ROLE_TOKEN_KIND=access

# Keycloak Admin API Configuration (for user/role management)
KEYCLOAK_ADMIN_URL=https://airwall.local/keycloak
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=<.env.secrets>

# Role Synchronization Settings
KEYCLOAK_TARGET_REALM=AirwallChat
KEYCLOAK_ROLE_SYNC_ENABLED=true
KEYCLOAK_ROLE_SYNC_INTERVAL_MINUTES=60
KEYCLOAK_ROLE_MAPPING_PREFIX=airwall-

# Security Settings
KEYCLOAK_REQUIRE_EMAIL_VERIFIED=false
KEYCLOAK_AUTO_CREATE_USERS=true
KEYCLOAK_AUTO_SYNC_ROLES=true

# OpenID Retry Settings (for microservice resilience)
OPENID_MAX_RETRIES=300
OPENID_RETRY_INTERVAL=3000

# Microsoft 365 Federation (configure in Azure AD first)
# MICROSOFT_CLIENT_ID=your-azure-app-client-id
# MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret