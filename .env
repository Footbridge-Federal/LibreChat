#==================================================#
#               Server Configuration               #
#==================================================#
APP_FQDN=https://airwall.local
MONGO_URI=mongodb://mongodb:27017/Airwall
RAG_OPENAI_BASEURL=http://rag_api:8000/v1
DOMAIN_CLIENT=${APP_FQDN}
DOMAIN_SERVER=${APP_FQDN}
APP_TITLE=Airwall.Chat
HELP_AND_FAQ_URL=https://airwall.ai
# JWT_SECRET=<.env.secrets>
# JWT_REFRESH_SECRET=<.env.secrets>

#===================================================#
#                    User System                    #
#===================================================#
BAN_VIOLATIONS=false
LIMIT_CONCURRENT_MESSAGES=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_ENV=development
HTTPS=false


#=================#
#       AWS       #
#=================#
BEDROCK_AWS_MODELS=us.anthropic.claude-opus-4-1-20250805-v1:0
AWS_DEFAULT_REGION=us-east-1
BEDROCK_AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID= <.env.secrets>
# AWS_SECRET_ACCESS_KEY= <.env.secrets>

#=================#
#     OpenAI      #
#=================#
OPENAI_MODELS=gpt-5,gpt-5-mini,gpt-5-nano,gpt-5-chat-latest


#===================================================#
#                        RAG                        #
#===================================================#
EMBEDDINGS_PROVIDER=bedrock
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0

#==================================================#
#                      Search                      #
#==================================================#
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://0.0.0.0:7700
MEILI_MASTER_KEY=DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt


#=================#
#    Keycloak     #
#=================#
# Token Lifespan Settings (in seconds)
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=60
KEYCLOAK_ACCESS_TOKEN_LIFESPAN_IMPLICIT=60
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=600
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=7200
REFRESH_TOKEN_EXPIRY=8000
# Brute Force Protection Settings
KEYCLOAK_MAX_FAILURE_WAIT_SECONDS=30
KEYCLOAK_MIN_QUICK_LOGIN_WAIT_SECONDS=5
KEYCLOAK_WAIT_INCREMENT_SECONDS=5
KEYCLOAK_QUICK_LOGIN_CHECK_MILLISECONDS=1000
KEYCLOAK_MAX_DELTA_TIME_SECONDS=300
KEYCLOAK_FAILURE_FACTOR=10

# Basic OpenID Connect Configuration
OPENID_ISSUER=${APP_FQDN}/keycloak/realms/AirwallChat
OPENID_CLIENT_ID=librechat-client
OPENID_CLIENT_SECRET=librechat-secret-123
OPENID_SCOPE=openid
OPENID_SESSION_SECRET=your-session-secret-change-in-production
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL="Continue with Keycloak"
OPENID_AUTO_REDIRECT=true

# Role Integration Configuration
OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles
OPENID_REQUIRED_ROLE_TOKEN_KIND=access

# Keycloak Admin API Configuration (for user/role management)
KEYCLOAK_ADMIN_URL=${APP_FQDN}/keycloak
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=<.env.secrets>

# Role Synchronization Settings
KEYCLOAK_TARGET_REALM=AirwallChat
KEYCLOAK_ROLE_SYNC_ENABLED=true
KEYCLOAK_ROLE_SYNC_INTERVAL_MINUTES=60
KEYCLOAK_ROLE_MAPPING_PREFIX=airwall-

# Security Settings
KEYCLOAK_REQUIRE_EMAIL_VERIFIED=false
KEYCLOAK_AUTO_CREATE_USERS=true
KEYCLOAK_AUTO_SYNC_ROLES=true

# OpenID Retry Settings (for microservice resilience)
OPENID_MAX_RETRIES=300
OPENID_RETRY_INTERVAL=3000

# SSO Logout Settings
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_REUSE_TOKENS=true

# Frontend Keycloak Environment Variables
KEYCLOAK_ENABLED=true
KEYCLOAK_SERVER_URL=${APP_FQDN}/keycloak
REACT_APP_KEYCLOAK_URL=${APP_FQDN}/keycloak
REACT_APP_KEYCLOAK_REALM=AirwallChat
AZURE_CLIENT_ID=6d62992c-6723-48db-a042-615af348e7e2
AZURE_TENANT_ID=1ecc67bc-d41b-4d17-b8df-1affe05e1799

#==================================================#
#              Model Access Control                #
#==================================================#
# Organization Configuration
AIRWALL_ORG_NAME=airwall
PARTNER_ORG_NAME=partner

# Airwall Organization Model Access
AIRWALL_ORG_MODELS_ALLOW=openai/gpt-4o-mini,anthropic/claude-3.5
AIRWALL_ORG_MAX_TOKENS=8000
AIRWALL_ORG_MONTHLY_LIMIT=2000000
AIRWALL_ORG_RATE_LIMIT=100

# Partner Organization Model Access
PARTNER_ORG_MODELS_ALLOW=openai/gpt-4o-mini
PARTNER_ORG_MAX_TOKENS=4000
PARTNER_ORG_MONTHLY_LIMIT=500000
PARTNER_ORG_RATE_LIMIT=30

# Premium Users Model Access
PREMIUM_USERS_MODELS_ALLOW=openai/gpt-4o,anthropic/claude-3.5,openai/gpt-4o-mini
PREMIUM_USERS_MAX_TOKENS=16000
PREMIUM_USERS_MONTHLY_LIMIT=5000000
PREMIUM_USERS_RATE_LIMIT=200

# Model Access Control Settings
MODEL_ACCESS_ENABLED=true
KEYCLOAK_AUTO_SYNC=true
KEYCLOAK_SYNC_INTERVAL=300000
MODEL_ACCESS_CACHE_TTL=300000
MODEL_ACCESS_DEFAULT_DENY=true
MODEL_ACCESS_LOGGING=true
MODEL_ACCESS_COST_TRACKING=true

# API Key Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# API_KEY_ENCRYPTION_KEY=<.env.secrets>

#==================================================#
#              Group API Key Configuration         #
#==================================================#
# Each group needs explicit API keys for the models it can access
# Format: {GROUP_NAME}_{PROVIDER}_API_KEY

# Airwall Organization API Keys
# AIRWALL_OPENAI_API_KEY=<.env.secrets>     # For openai/gpt-4o-mini
# AIRWALL_ANTHROPIC_API_KEY=<.env.secrets>  # For anthropic/claude-3.5

# Partner Organization API Keys
# PARTNER_OPENAI_API_KEY=<.env.secrets>     # For openai/gpt-4o-mini

# Premium Users API Keys
# PREMIUM_OPENAI_API_KEY=<.env.secrets>     # For openai/gpt-4o, gpt-4o-mini
# PREMIUM_ANTHROPIC_API_KEY=<.env.secrets>  # For anthropic/claude-3.5

# AWS/Bedrock Keys (if using bedrock models)
# AIRWALL_AWS_ACCESS_KEY_ID=<.env.secrets>
# AIRWALL_AWS_SECRET_ACCESS_KEY=<.env.secrets>